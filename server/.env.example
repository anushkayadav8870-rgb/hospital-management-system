# =============================================
# PulseCare HMS — Server Environment Variables Template
# =============================================
# Copy this file to .env locally or set in Cloud dashboard (Render / Railway):
# =============================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (Discrete Local Fields)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hms_db
DB_USER=hms_user
DB_PASSWORD=hms_password

# Cloud Database Connection String (Production Render / Neon / Supabase DB)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
